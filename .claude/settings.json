{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git submodule status:*)",
      "Bash(tmux source-file:*)"
    ],
    "deny": [
      "Read(./gh/**)",
      "Read(./gcloud/**)",
      "Read(./1Password/**)",
      "Read(./spotify-player/**)",
      "Read(./context7/**)",
      "Read(./nono/**)",
      "Read(./k9s/**)",
      "Read(./containers/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-add.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-config.sh" }
        ]
      }
    ]
  }
}
